    "NSContactsUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "UVVA looks for your friends among your contacts. Nothing is added or sent without you."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A UVVA procura seus amigos entre seus contatos. Nada é adicionado ou enviado sem a sua ação."
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "UVVA saves the pictures you share, like your palate map or a dinner menu, to your photos."

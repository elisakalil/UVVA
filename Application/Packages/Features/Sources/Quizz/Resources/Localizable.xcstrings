    },
    "%@ taste in wine is" : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O paladar de %@ para vinhos é"
          }
        }
      }
    },
    "%lld" : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld"
          }
        }
      }
    },
    "%lld of %lld" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$lld of %2$lld"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld de %2$lld"
          }
        }
      }
    },
    "Answer eight questions about the food you love. We turn your answers into a taste map and use it to find wines you'll enjoy." : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Responda a oito perguntas sobre os sabores que você adora. Usamos suas respostas para mapear seu paladar e encontrar vinhos de que você vai gostar."
          }
        }
      }
    },
    "Answer for the food, not the bottle." : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pense na comida ao responder."
          }
        }
      }
    },
    "Change question" : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trocar pergunta"
          }
        }
      }
    },
    "Discover your taste in wine" : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descubra seu paladar para vinhos"
          }
        }
      }
    },
    "Draw the map" : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Criar meu mapa"
          }
        }
      }
    },
    "Eight readings · two minutes" : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oito respostas · dois minutos"
          }
        }
      }
    },
    "Every time you save a note on a wine you liked, UVVA recalculates your eight readings. The map you see here is your taste today, not a verdict." : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sempre que você salva uma nota sobre um vinho de que gostou, a UVVA recalcula os oito eixos. O mapa mostra seu paladar de hoje, que pode mudar com o tempo."
          }
        }
      }
    },
    "Every wine" : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada vinho"
          }
        }
      }
    },
    "How your map is drawn" : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Como seu mapa é criado"
          }
        }
      }
    },
    "Keep this map" : {

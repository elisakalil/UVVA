    },
    "Your phone number" : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu número de telefone"
          }
        }
      }
    },
    "Your readings" : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suas leituras"
          }
        }
      }
    },
    "Your studies follow %@ through the wine world. Each grape gives you a different way to read the glass." : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seus estudos acompanham %@ pelo mundo do vinho. Cada casta oferece uma maneira diferente de interpretar o que está na taça."
          }
        }
      }
    }
  },
  "version" : "1.0"

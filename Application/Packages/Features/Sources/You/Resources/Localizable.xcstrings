        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este é meu paladar para vinhos. Mapeie o seu na UVVA e vamos encontrar o vinho perfeito para beber juntos. %@"
          }
        }
      }
    },
    "This permanently removes your palate map, cellar, tables and certificates. It cannot be undone." : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {

          "stringUnit" : {
            "state" : "new",
            "value" : "The grapes you’ve studied lead to %1$@. With %2$@ as your guide, that corner of the wine map is coming into focus."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As castas que você estudou levam a %1$@. Com %2$@ como guia, você começa a conhecer melhor esse canto do mundo do vinho."

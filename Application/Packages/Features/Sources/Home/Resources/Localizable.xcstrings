    "Tap + and photograph the front and back of a bottle. UVVA reads the label and keeps the wine in your cellar. Every wine you rate moves your map." : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque em + e fotografe a frente e o verso de uma garrafa. A UVVA lê o rótulo e guarda o vinho na sua adega. Cada vinho que você avalia move o seu mapa."
          }
        }
      }
    },
    "TAP ANYWHERE TO LEAVE" : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TOQUE EM QUALQUER LUGAR PARA SAIR"
          }
        }
      }
    },
    "Tempranillo" : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tempranillo"
          }
        }
      }
    },
    "That mouthwatering acidity you like? It's here." : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {

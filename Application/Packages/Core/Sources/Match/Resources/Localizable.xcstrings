          }
        }
      }
    },
    "The shape of what you reach for in a glass." : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O mapa do que você procura em uma taça."
          }
        }
      }
    },
    "Unoaked" : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sem carvalho"
          }
        }
      }
    },
    "Very floral" : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muito floral"
          }
        }
      }
    },
    "Very much" : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muitíssimo"
          }
        }
      }
    },
    "Very oaky" : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Carvalho intenso"
          }
        }
      }
    },
    "Very spicy" : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muito especiado"
          }
        }
      }
    },
    "Zesty" : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cítrico e vivo"
          }
        }
      }
    },
    "a little residual sugar reads as generosity to you, not as a flaw" : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "um pouco de açúcar residual deixa o vinho mais agradável para você"
          }
        }
      }
    },
    "acidity is the first thing you notice, and it is what keeps a wine awake for you" : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "a acidez é a primeira coisa que você nota e dá vida ao vinho"
          }
        }
      }
    },
    "balance, every axis in the middle" : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "equilíbrio, com todos os eixos no meio da escala"
          }
        }
      }
    },
    "balance, most axes in the middle" : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "equilíbrio, com a maioria dos eixos no meio da escala"
          }
        }
      }
    },
    "every axis runs high on your map: you want a wine that does a lot at once, with nothing held back" : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "todos os eixos do seu mapa estão em alta: você gosta de um vinho intenso em vários aspectos"
          }
        }
      }
    },
    "every axis sits in the middle: you want balance, a wine where nothing is too much or too little" : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "todos os eixos estão no meio da escala: você gosta de um vinho equilibrado, na medida certa"
          }
        }
      }
    },
    "every axis sits low on your map: you want a quiet wine, one that whispers instead of making a point" : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "todos os eixos têm intensidade baixa: você prefere um vinho discreto, que fala baixinho"
          }
        }
      }
    },
    "everything at once, every axis turned up" : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "intensidade em todos os eixos de uma vez"
          }
        }
      }
    },
    "everything but %@" : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tudo, com exceção de %@"
          }
        }
      }
    },
    "floral aromatics read as soap to you" : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "para você, aromas florais lembram sabonete"
          }
        }
      }
    },
    "many things at once" : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "muitas características de uma só vez"
          }
        }
      }
    },
    "most of the map runs high: you want a wine that does a lot at once, with no single axis in charge" : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "a maior parte do mapa tem intensidade alta: você gosta de vinhos intensos, com várias características em destaque"
          }
        }
      }
    },
    "most of the map stays quiet: you want restraint more than power" : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "a maior parte do mapa tem intensidade baixa: você prefere vinhos discretos e delicados"
          }
        }
      }
    },
    "nothing on the map climbs high, so no single part of a wine has to lead" : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "nenhum eixo tem intensidade alta, então você dispensa um sabor dominante"
          }
        }
      }
    },
    "nothing on the map is truly low: you leave room for every part of a wine" : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "nenhum eixo tem intensidade muito baixa: há espaço para cada característica do vinho"
          }
        }
      }
    },
    "pepper and clove are what you go looking for" : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "pimenta e cravo são os aromas que você procura"
          }
        }
      }
    },
    "perfume pulls you in before structure ever does" : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "o perfume conquista você antes mesmo de perceber a estrutura"
          }
        }
      }
    },
    "restraint, every axis kept low" : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "delicadeza, com intensidade baixa em todos os eixos"
          }
        }
      }
    },
    "restraint, most axes kept low" : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "delicadeza, com intensidade baixa na maioria dos eixos"
          }
        }
      }
    },
    "ripe fruit is the point for you, not a beginner's phase to grow out of" : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "fruta madura é essencial para você, um gosto que vai além da primeira taça"
          }
        }
      }
    },
    "several axes at once" : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "vários eixos ao mesmo tempo"
          }
        }
      }
    },
    "sharpness tires you out; you want a rounder line through the middle" : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "a acidez cortante cansa seu paladar, que prefere sabores mais redondos"
          }
        }
      }
    },
    "spice distracts you from the fruit" : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "as especiarias tiram sua atenção da fruta"
          }
        }
      }
    },
    "sugar reads as a flaw to you, and dry means dry" : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "você percebe açúcar e prefere que um vinho seco seja bem seco"
          }
        }
      }
    },
    "tannin gets in the way for you; you want fruit without the scaffolding" : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "o tanino atrapalha: você quer sentir a fruta com pouca adstringência"
          }
        }
      }
    },
    "vanilla, smoke and toast are part of the pleasure, not a cover-up" : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "baunilha, fumaça e tostado fazem parte do prazer para você"
          }
        }
      }
    },
    "you look past fruit for earth, salt and stone" : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "além da fruta, você procura notas de terra, sal e pedra"
          }
        }
      }
    },
    "you want a wine that stays light and gets out of the way" : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "você quer um vinho leve, que deixe os outros sabores aparecerem"
          }
        }
      }
    },
    "you want grip, the drying pull that holds a red upright" : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "você gosta da adstringência que dá estrutura a um tinto"
          }
        }
      }
    },
    "you want the grape, not the barrel" : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "você quer sentir a uva, com pouca influência da barrica"
          }
        }
      }
    },
    "you want weight in the glass, something that coats and stays" : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "você gosta de um vinho encorpado, que preenche a boca e permanece"
          }
        }
      }
    },
    "Serves %lld" : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rende %lld porções"

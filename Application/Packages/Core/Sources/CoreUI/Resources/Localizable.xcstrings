    "Notes" : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notas"
          }
        }
      }
    },
    "Notice how much you salivate after the sip. A little mouthwatering is low. If your mouth reacts like it just met a lemon, go high." : {
      "extractionState" : "stale",
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Repare em quanto você saliva depois do gole. Se a boca só encheu um pouquinho d’água, marque baixo. Se parece que acabou de encontrar um limão, marque alto."
          }
        }
      }
    },
    "Notice the weight of the sip. Think water at one end, whole milk at the other. How much does the wine fill your mouth?" : {
      "extractionState" : "stale",
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Repare no peso do gole. Pense em água de um lado e leite integral do outro. Quanto o vinho preenche a boca?"
          }
        }
      }
    },

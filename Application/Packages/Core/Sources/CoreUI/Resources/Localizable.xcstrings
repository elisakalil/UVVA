          "stringUnit" : {
            "state" : "translated",
            "value" : "Rosé"
          }
        }
      }
    },
    "Run your tongue along your gums after the sip. A little grip is low. That dry, strong-black-tea feeling goes high." : {
      "extractionState" : "stale",
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passe a língua pela gengiva depois do gole. Se ela prende só um pouco, marque baixo. Se a boca fica seca como depois de um chá preto forte, marque alto."
          }
        }
      }
    },
    "Save note" : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salvar nota"
          }

        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A carta de vinhos"
          }
        }
      }
    },
    "Think petals. A faint violet is low. If it smells like you walked into a flower shop, go high." : {
      "extractionState" : "stale",
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pense em pétalas. Um toque de violeta fica no começo da linha. Se parece que você entrou numa floricultura, vá para o outro extremo."
          }
        }
      }
    },
    "This doesn’t look like a wine" : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso não parece ser um vinho"
          }
        }
      }
    },
    "This wine" : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este vinho"
          }
        }
      }
    },
    "This wine and you" : {
